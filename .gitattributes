# Keep repository text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Native Windows command scripts conventionally use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never undergo line-ending conversion.
*.wav binary
*.bin binary
*.elf binary
*.hex binary
*.uf2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
